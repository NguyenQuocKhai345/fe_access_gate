# API Gateway routes /api/{service}/... to backend services.
VITE_API_BASE_URL=http://localhost:8080/api

# Authorization redirects to Identity; the token exchange goes through Gateway.
VITE_IDENTITY_BASE_URL=http://localhost:8081
VITE_OAUTH_TOKEN_URL=http://localhost:8080/api/identity/oauth2/token
VITE_OAUTH_CLIENT_ID=tmc-web
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/callback
VITE_OAUTH_SCOPE=qr.issue access.review attendance.write hr.export audit.read stations.read stations.manage attendance.read
